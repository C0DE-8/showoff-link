# Local MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=showoff-links

# Backend HTTP port
PORT=3000

# Browser app origins allowed to call the API (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# Optional fixed public client origin. Leave unset to use each allowed request's Origin header.
# PUBLIC_SITE_URL=https://your-production-domain.example
